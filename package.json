{
  "name": "gdr-erp",
  "version": "1.34.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:migrate": "npm run db:migrate --workspace=apps/api",
    "db:seed": "npm run db:seed --workspace=apps/api",
    "db:studio": "npm run db:studio --workspace=apps/api",
    "stamp:build": "node scripts/stamp-build-info.js",
    "deploy:api": "npm run stamp:build && railway up --ci; git checkout -- apps/api/build-info.json",
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major",
    "changelog:draft": "node scripts/changelog-draft.js",
    "smoke:isolation": "node scripts/smoke-tenant-isolation.mjs"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  },
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20.0.0"
  }
}
