# Database
DATABASE_URL="postgresql://gdr:gdr_dev_pass@localhost:5432/gdr_erp"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="change-me-in-production-very-long-random-string"
JWT_EXPIRY="15m"
JWT_REFRESH_SECRET="change-me-refresh-very-long-random-string"
JWT_REFRESH_EXPIRY="7d"
# Cookies de sessão (#349): 'lax' quando o front e a API estão no MESMO site
# (ex.: app.avecchi.ai × api.avecchi.ai) — mais restritivo e imune ao bloqueio
# de cookies de terceiros do Safari. 'none' (default em produção) funciona em
# qualquer topologia. Em produção o cookie é sempre Secure.
AUTH_COOKIE_SAMESITE="none"

# Minutos sem NENHUMA requisição até a sessão expirar por inatividade (#341).
# Default 15. Cada requisição autenticada empurra o relógio para frente.
SESSION_IDLE_TIMEOUT_MINUTES="15"

# Idade máxima ABSOLUTA da sessão nas rotas /ops (OPS WP7 #914). Passou disso
# desde o login, o portal da operadora fecha (403) até um novo login — o app
# segue normal com a mesma sessão. Faixa 15..1440; default 480 (8h).
OPS_SESSION_MAX_AGE_MINUTES="480"

# Ponte billing->financeiro (AVECCHI P1 #960): id da EMPRESA da operadora no
# proprio sistema - fatura de mensalidade vira titulo a receber nesse tenant.
# Vazio/ausente = ponte desligada.
OPERADORA_COMPANY_ID=""

# Criptografia em repouso (AES-256-GCM — EncryptionService, #344)
# Obrigatória APENAS se MFA for usado (sem ela, /auth/mfa/* responde 503).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENCRYPTION_KEY="64-caracteres-hexadecimais"

# API
API_PORT=3001
API_PREFIX=api

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# Segregação de Funções (SoD) nas aprovações de PO/PR (#160/#350)
# false (padrão): regra de negócio vigente — a mesma pessoa PODE criar e aprovar
#                 o documento, e o mesmo usuário pode aprovar níveis distintos.
# true: trava de SoD ativa — criador não aprova o próprio documento e cada
#       nível de alçada exige um aprovador distinto (vale até para SUPER_ADMIN).
# A auditoria (LEVEL_APPROVE com userId/approvedById) registra SEMPRE,
# independente desta flag.
SOD_ENFORCE=false

# ─── WhatsApp Cloud API — CRM F1.2 (#508) ─────────────────────────────────────
# App da Meta (developers.facebook.com) do WABA da GDR
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_API_VERSION=v21.0
# phone_number_id de cada loja vai na coluna Company.waPhoneNumberId (não é env)

# ─── Conectores CRM F1.4-F1.6 (#510/#511/#512) ────────────────────────────────
# Meta Lead Ads (#510) — reaproveita WHATSAPP_APP_SECRET/VERIFY_TOKEN se do mesmo app
# META_APP_SECRET=
# META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
# Mercado Livre (#511) — refresh token rotaciona e é persistido em SystemParameter
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_ACCESS_TOKEN=
ML_REFRESH_TOKEN=
# OLX (#511) — automação do e-mail de notificação chama o hook com este secret
OLX_WEBHOOK_SECRET=
# WABA id (business account) — sync de templates F3.2 (#518)
WHATSAPP_WABA_ID=

# SDR IA (F4 #521-525) — API da Anthropic. Sem a key, o SDR fica inerte e o
# fluxo humano (rodízio F1.7) segue intocado. Ligar por loja em Config CRM.
ANTHROPIC_API_KEY=

# ─── Web Push / PWA — CRM V2.1 (#568) ─────────────────────────────────────────
# Chaves VAPID (gerar: ./node_modules/.bin/web-push generate-vapid-keys).
# Sem as chaves o push fica desativado (no-op) — o CRM funciona normalmente.
# A pública também é servida ao navegador via GET /notifications/push/public-key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: ou URL de contato exigido pelo protocolo (padrão: mailto:contato@gdrreboques.com.br)
# VAPID_SUBJECT=

# ─── Suporte — issue no GitHub redigida (#767) ────────────────────────────────
# Sem token/repo o GithubIssueService é no-op: o chamado funciona normalmente,
# só não espelha o incidente numa issue do time. O token precisa de escopo
# "repo" (issues:write). Repo no formato "owner/repo".
SUPPORT_GITHUB_TOKEN=
SUPPORT_GITHUB_REPO=
