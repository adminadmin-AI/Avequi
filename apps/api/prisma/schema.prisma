// ═══════════════════════════════════════════════════════════════════════════════
// IAM v2 — Fase F1 (M0): fundação de dados (#335 RBAC · #336 Sessões · #337 Auditoria)
// Segue docs/iam/ARQUITETURA-IAM-V2.md (proposta do PR #461).
// Tabelas 100% novas e aditivas — nenhum modelo existente foi alterado de forma
// destrutiva. Nesta fase NENHUM código lê estas tabelas (Fase M0 da migração).
// ═══════════════════════════════════════════════════════════════════════════════

// ─── #335 — RBAC core ─────────────────────────────────────────────────────────

/// Catálogo de permissões granulares. code = "modulo.recurso.acao"
/// (ex.: "production.orders.approve"). O catálogo é versionado em código
/// (Decisão 2) e materializado aqui via seed idempotente (#338).
model Permission {
  id          String   @id @default(cuid())
  code        String   @unique // ex: "sales.order.create"
  name        String // pt-BR, ex: "Criar Pedido de Venda"
  description String?
  module      String // ex: "sales"
  resource    String // ex: "order"
  action      String // ex: "create" — ações padronizadas do catálogo em código
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions      RolePermission[]
  userPermissions      UserPermission[]
  permissionChangeLogs PermissionChangeLog[]

  @@index([module])
  @@index([module, resource])
  @@map("gdr_permissions")
}

/// Perfil de acesso (role RBAC). isSystem = perfil built-in (22+ da #339),
/// não editável. companyId null = perfil global; preenchido = perfil
/// customizado da empresa. Herança via parentId (Supervisor herda Operador).
model Role {
  id          String   @id @default(cuid())
  code        String // ex: "GERENTE_INDUSTRIAL"
  name        String // ex: "Gerente Industrial"
  description String?
  isSystem    Boolean  @default(false)
  parentId    String?
  parent      Role?    @relation("RoleHierarchy", fields: [parentId], references: [id])
  children    Role[]   @relation("RoleHierarchy")
  companyId   String? // null = global
  company     Company? @relation(fields: [companyId], references: [id])
  isActive    Boolean  @default(true)
  // IAM v2 — F4.1 (#344): enforcement de MFA por perfil. true = usuários com
  // este perfil DEVEM ter MFA habilitado. Enforcement SUAVE por ora: o login
  // responde mfaSetupRequired=true mas NÃO bloqueia — o enforcement duro
  // (bloquear login sem MFA após grace period) é decisão pendente do Rafael.
  requireMfa  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions      RolePermission[]
  userAssignments      UserRoleAssignment[]
  permissionChangeLogs PermissionChangeLog[]

  // Unicidade de `code` POR empresa/grupo: empresas diferentes podem ter perfis
  // com o mesmo code (ex.: "GERENTE_LOJA") sem colidir. Segue o padrao
  // @@unique([companyId, code]) usado no resto do schema.
  // OBS: perfis GLOBAIS/system (companyId = null) NAO sao cobertos por este
  // indice (no Postgres, NULLs sao distintos em UNIQUE). A unicidade dos codes
  // globais e garantida por um INDICE PARCIAL criado na migration
  // (gdr_roles_code_global_key ... WHERE "companyId" IS NULL), que o Prisma nao
  // consegue expressar no schema.
  @@unique([companyId, code])
  @@index([companyId])
  @@map("gdr_roles")
}

// ─── #344 — MFA/2FA TOTP (Bloco D da arquitetura) ────────────────────────────

/// MFA TOTP do usuário (#344). `secret` é o secret TOTP em base32 CRIPTOGRAFADO
/// com AES-256-GCM (EncryptionService, env ENCRYPTION_KEY) — nunca em claro.
/// `enabled` só vira true depois que o usuário CONFIRMA o setup com um código
/// válido (setup → confirm). `backupCodes` guarda os hashes bcrypt dos 10
/// códigos de recuperação (uso único: o hash é removido do array ao ser usado;
/// o código em claro é mostrado UMA vez, no confirm/regenerate).
model UserMFA {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret      String // secret TOTP criptografado (formato v1:<iv>:<tag>:<ct>)
  enabled     Boolean   @default(false)
  verifiedAt  DateTime? // quando o usuário confirmou o setup
  backupCodes String[]  @default([]) // hashes bcrypt, uso único
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("gdr_user_mfa")
}

/// Vínculo perfil ↔ permissão. granted=false = deny explícito (vence grant).
/// scope JSON: restrição de escopo (ex.: {"branch": ["CWB"]}) — ABAC mínimo
/// da Decisão 1; null = sem restrição.
model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  scope        Json?
  granted      Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("gdr_role_permissions")
}

/// Atribuição de perfil a usuário, com escopo empresa + filial (Decisão 3).
/// NOME: "UserRoleAssignment" e não "UserRole" — o enum UserRole (User.role)
/// já existe e CONTINUA valendo como fallback durante toda a migração.
/// branchId null = todas as filiais. expiresAt = atribuição temporária.
model UserRoleAssignment {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role      @relation(fields: [roleId], references: [id])
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  branchId  String?
  branch    Branch?   @relation(fields: [branchId], references: [id])
  expiresAt DateTime?
  grantedBy String // userId de quem concedeu (sem FK: preservado mesmo se o concessor sair)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, roleId, companyId])
  @@index([userId])
  @@index([roleId])
  @@index([companyId])
  @@map("gdr_user_role_assignments")
}

/// Exceção por usuário: grant OU deny (granted=false) de uma permissão
/// específica, acima do que os perfis dão. reason = justificativa (auditável).
model UserPermission {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id])
  granted      Boolean    @default(true)
  scope        Json?
  expiresAt    DateTime?
  grantedBy    String // userId de quem concedeu
  reason       String? // justificativa da exceção
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([userId, permissionId, companyId])
  @@index([userId])
  @@index([companyId])
  @@map("gdr_user_permissions")
}

// ─── #335 — Organização (Branch = segurança agora; Dept/Team = estrutura, Decisão 3) ──

/// Filial física (CWB, JOI, GUA). Entra no CÁLCULO de permissão
/// (UserRoleAssignment.branchId / scope JSON) — Decisão 3, estágio 1.
model Branch {
  id        String   @id @default(cuid())
  name      String
  code      String // ex: CWB, JOI, GUA
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  cnpj      String?
  address   Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoleAssignments UserRoleAssignment[]

  @@unique([companyId, code])
  @@map("gdr_branches")
}

/// Departamento — APENAS estrutura organizacional nesta fase (Decisão 3):
/// NÃO participa do cálculo de permissão até a fase 2 do multi-tenant (#347).
model Department {
  id        String       @id @default(cuid())
  name      String
  code      String
  companyId String
  company   Company      @relation(fields: [companyId], references: [id])
  managerId String?
  manager   User?        @relation("DepartmentManager", fields: [managerId], references: [id])
  parentId  String?
  parent    Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children  Department[] @relation("DepartmentHierarchy")
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  teams Team[]
  users UserDepartment[]

  @@unique([companyId, code])
  @@map("gdr_departments")
}

/// Equipe dentro de um departamento — estrutura organizacional (Decisão 3).
model Team {
  id           String     @id @default(cuid())
  name         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  leaderId     String?
  leader       User?      @relation("TeamLeader", fields: [leaderId], references: [id])
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  members UserTeam[]

  @@map("gdr_teams")
}

/// Junction usuário ↔ departamento.
model UserDepartment {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  isPrimary    Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@unique([userId, departmentId])
  @@map("gdr_user_departments")
}

/// Junction usuário ↔ equipe.
model UserTeam {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, teamId])
  @@map("gdr_user_teams")
}

// ─── #336 — Sessões, dispositivos e tentativas de login ──────────────────────

enum SessionRevokedReason {
  LOGOUT // logout voluntário
  EXPIRED // inatividade / expiração
  ADMIN_REVOKE // revogada remotamente por admin
  SECURITY // evento de segurança (reuso de refresh, lockout, etc.)
}

/// Sessão de usuário (Decisão 4 — híbrido): o access token JWT continua
/// stateless (15 min) e ganha o claim sessionId; o REFRESH é amarrado à
/// sessão — revogar a sessão mata o refresh. refreshTokenId aponta para o
/// RefreshToken vigente (atualizado a cada rotação).
model UserSession {
  id                String                @id @default(cuid())
  userId            String
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId         String
  company           Company               @relation(fields: [companyId], references: [id])
  refreshTokenId    String?               @unique
  refreshToken      RefreshToken?         @relation(fields: [refreshTokenId], references: [id])
  ipAddress         String?
  userAgent         String?
  deviceFingerprint String?
  city              String? // GeoIP lookup (quando disponível)
  country           String?
  expiresAt         DateTime?
  lastActivityAt    DateTime              @default(now())
  revokedAt         DateTime?
  revokedReason     SessionRevokedReason?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  auditLogsV2 AuditLogV2[]

  @@index([userId, revokedAt])
  @@index([companyId])
  @@index([deviceFingerprint])
  @@map("gdr_user_sessions")
}

enum LoginFailReason {
  WRONG_PASSWORD
  INACTIVE
  LOCKED
  MFA_FAILED
}

/// Tentativa de login (sucesso ou falha) — base do lockout (#342):
/// 5 falhas em 15min → User.lockedUntil. Sem FK para User de propósito:
/// registra também tentativas com e-mail inexistente.
model LoginAttempt {
  id         String           @id @default(cuid())
  email      String
  ipAddress  String?
  userAgent  String?
  success    Boolean
  failReason LoginFailReason?
  createdAt  DateTime         @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@map("gdr_login_attempts")
}

/// Dispositivo confiável do usuário (fingerprint). Dispositivo novo gera
/// SecurityEvent(WARNING) no login.
model TrustedDevice {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprint String
  name        String? // ex: "Notebook do Rafael"
  trusted     Boolean   @default(false)
  trustedAt   DateTime?
  trustedBy   String? // userId de quem marcou como confiável
  lastSeenAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, fingerprint])
  @@map("gdr_trusted_devices")
}

// ─── #337 — Auditoria enterprise (v2 nasce AO LADO da v1 — sem DROP) ─────────

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  CANCEL
  FINALIZE
  REOPEN
  EXPORT
  IMPORT
  PRINT
  EXECUTE
  PROCESS
  LOGIN
  LOGOUT
  OTHER
}

/// Auditoria v2 (redesign da #337). A tabela gdr_audit_logs (v1) NÃO é
/// alterada nem removida — a v2 nasce ao lado e a v1 será aposentada depois,
/// sem DROP. Escrita async via fila Bull (Decisão 5); registros NUNCA são
/// deletados (retenção 5–7 anos).
model AuditLogV2 {
  id        String       @id @default(cuid())
  companyId String
  company   Company      @relation(fields: [companyId], references: [id])
  userId    String?
  user      User?        @relation(fields: [userId], references: [id])
  sessionId String?
  session   UserSession? @relation(fields: [sessionId], references: [id])
  entity    String // ex: "Product"
  entityId  String?
  action    AuditAction
  module    String? // ex: "production"
  oldValue  Json? // diff: estado anterior
  newValue  Json? // diff: estado novo
  ipAddress String?
  userAgent String?
  requestId String? // correlação de request
  duration  Int? // ms
  createdAt DateTime     @default(now())

  @@index([companyId, entity, entityId])
  @@index([companyId, createdAt])
  @@index([userId, createdAt])
  @@index([requestId])
  @@map("gdr_audit_logs_v2")
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  PASSWORD_CHANGED
  ROLE_CHANGED
  PERMISSION_GRANTED
  PERMISSION_REVOKED
  SESSION_REVOKED
  LOCKOUT
  ACCOUNT_UNLOCKED
  MFA_ENABLED
  MFA_DISABLED
  TOKEN_REUSE_DETECTED
  NEW_DEVICE
  SUSPICIOUS_ACTIVITY
  MFA_BACKUP_CODES_REGENERATED
}

enum SecurityEventSeverity {
  INFO
  WARNING
  CRITICAL
}

/// Evento de segurança — gravação SÍNCRONA (mesma transação da ação, Decisão 5).
/// companyId/userId opcionais: login falho de e-mail desconhecido não tem nenhum dos dois.
model SecurityEvent {
  id        String                @id @default(cuid())
  companyId String?
  company   Company?              @relation(fields: [companyId], references: [id])
  userId    String?
  user      User?                 @relation(fields: [userId], references: [id])
  eventType SecurityEventType
  severity  SecurityEventSeverity @default(INFO)
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime              @default(now())

  @@index([companyId, createdAt])
  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@map("gdr_security_events")
}

enum PermissionChangeType {
  ROLE_ASSIGNED
  ROLE_REMOVED
  PERMISSION_GRANTED
  PERMISSION_REVOKED
}

/// Trilha de mudanças de acesso — gravação SÍNCRONA (Decisão 5): auditoria
/// de permissão que se perde numa fila é auditoria que não existe.
model PermissionChangeLog {
  id              String               @id @default(cuid())
  companyId       String
  company         Company              @relation(fields: [companyId], references: [id])
  targetUserId    String
  targetUser      User                 @relation("PermissionChangeTarget", fields: [targetUserId], references: [id])
  changedByUserId String
  changedByUser   User                 @relation("PermissionChangeAuthor", fields: [changedByUserId], references: [id])
  changeType      PermissionChangeType
  roleId          String?
  role            Role?                @relation(fields: [roleId], references: [id])
  permissionId    String?
  permission      Permission?          @relation(fields: [permissionId], references: [id])
  previousState   Json?
  newState        Json?
  reason          String?
  createdAt       DateTime             @default(now())

  @@index([companyId, createdAt])
  @@index([targetUserId, createdAt])
  @@map("gdr_permission_change_logs")
}

// ─── CRM de Lojas — F1.1 (#507, épico #506) ──────────────────────────────────

enum LeadSource {
  WHATSAPP
  META_ADS
  OLX
  MERCADO_LIVRE
  SITE
  TELEFONE
}

/// OPEN = estágio de trabalho; WON/LOST são terminais (WON dispara conversão F2.2)
enum PipelineStageType {
  OPEN
  WON
  LOST
}

enum LeadActivityType {
  MESSAGE_IN
  MESSAGE_OUT
  STAGE_CHANGE
  ASSIGNMENT
  NOTE
  CALL
  CONVERSION
}

enum WaMessageDirection {
  IN
  OUT
}

enum WaMessageType {
  TEXT
  AUDIO
  IMAGE
  DOCUMENT
  VIDEO
  STICKER
  LOCATION
  CONTACTS
  UNSUPPORTED
}

enum WaMessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

/// Estágio do funil por loja (kanban F2.1). Seed padrão: Novo → Em atendimento →
/// Proposta → Negociação → Fechado (WON) / Perdido (LOST). Ver scripts/seed-crm-stages-507.ts
model PipelineStage {
  id        String            @id @default(cuid())
  companyId String            @map("company_id")
  company   Company           @relation(fields: [companyId], references: [id])
  name      String
  order     Int               @default(0) // posição da coluna no kanban
  color     String?           @db.VarChar(7) // hex #RRGGBB
  type      PipelineStageType @default(OPEN)
  isActive  Boolean           @default(true) @map("is_active")
  leads     Lead[]
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  @@index([companyId, order])
  @@map("gdr_pipeline_stages")
}

/// Lead do CRM. TODO caminho de criação passa pelo LeadIntakeService (#513) —
/// dedup por telefone garantido pela constraint (companyId, phone), não só por código.
model Lead {
  id                String                @id @default(cuid())
  companyId         String                @map("company_id") // loja dona do lead
  company           Company               @relation(fields: [companyId], references: [id])
  name              String?
  /// E.164 sem máscara (ex: 5545999998888). Null só p/ origem sem telefone (pergunta ML) —
  /// nesses casos o dedup usa externalRef.
  phone             String?               @db.VarChar(15)
  email             String?
  source            LeadSource
  /// Ref externa da origem: id da conta ML, leadgen_id Meta etc. Dedup secundário (F1.4/F1.5)
  externalRef       String?               @map("external_ref")
  /// Metadados da captação (campanha/adset/ad do Meta, link do anúncio ML...) p/ dashboard F3.1
  sourceMeta        Json?                 @map("source_meta")
  interest          String? // modelo/categoria de reboque de interesse (texto livre na F1)
  estimatedValue    Decimal?              @map("estimated_value") @db.Decimal(12, 2)
  stageId           String?               @map("stage_id")
  stage             PipelineStage?        @relation(fields: [stageId], references: [id])
  /// Ordenação drag&drop dentro da coluna (padrão Twenty): novo card recebe a média
  /// das posições vizinhas — sem reindexar a coluna
  position          Decimal               @default(0) @db.Decimal(30, 15)
  assignedToId      String?               @map("assigned_to_id")
  assignedTo        User?                 @relation("LeadAssignee", fields: [assignedToId], references: [id])
  /// Última atribuição (rodízio/manual) — base da contagem diária do round-robin (#513)
  assignedAt        DateTime?             @map("assigned_at")
  /// Preenchido na conversão lead→cliente (F2.2 #515)
  customerId        String?               @map("customer_id")
  customer          Customer?             @relation(fields: [customerId], references: [id])
  /// OV gerada na conversão (F2.2 #515) — vínculo lead→receita; listener
  /// SALE_INVOICED fecha o lead quando a NF-e sai
  salesOrderId      String?               @unique @map("sales_order_id")
  salesOrder        SalesOrder?           @relation(fields: [salesOrderId], references: [id])
  lostReason        String?               @map("lost_reason") // obrigatório (via código) ao mover p/ stage LOST
  /// Primeira MESSAGE_OUT após criação — métrica de SLA (F2.3 #516)
  firstRespondedAt  DateTime?             @map("first_responded_at")
  lastInteractionAt DateTime?             @map("last_interaction_at") // qualquer atividade — alimenta "lead esfriando"
  /// LGPD (#558): anonimizado a pedido do titular ou por retenção — nome/telefone/
  /// email/conversa apagados; source/stage/OV preservados p/ métricas agregadas
  anonymizedAt      DateTime?             @map("anonymized_at")
  /// F4 SDR IA (#521): null = nunca atendido pela IA
  sdrStatus         SdrLeadStatus?        @map("sdr_status")
  sdrUsages         SdrUsage[]
  activities        LeadActivity[]
  reminders         LeadReminder[]
  conversation      WhatsappConversation?
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  @@unique([companyId, phone])
  @@index([companyId, stageId, position])
  @@index([companyId, assignedToId])
  @@index([companyId, externalRef])
  @@map("gdr_leads")
}

/// Timeline polimórfica do lead (padrão Twenty): mensagens, mudanças de estágio,
/// atribuições, notas, conversão — tudo numa linha do tempo só. properties carrega
/// o payload específico do tipo (diff de estágio, id da mensagem, resumo da IA...).
model LeadActivity {
  id         String           @id @default(cuid())
  leadId     String           @map("lead_id")
  lead       Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type       LeadActivityType
  happensAt  DateTime         @default(now()) @map("happens_at")
  /// User.id do autor; null = sistema (rodízio, listener) ou cliente (MESSAGE_IN).
  /// Sem FK de propósito: F4 usa actorId sintético "SDR_IA"
  actorId    String?          @map("actor_id")
  properties Json?

  @@index([leadId, happensAt])
  @@map("gdr_lead_activities")
}

/// Conversa WhatsApp 1:1 com o lead (número da LOJA, Cloud API — F1.2 #508).
/// windowExpiresAt = última msg do cliente + 24h (janela de resposta livre da Meta).
model WhatsappConversation {
  id                    String            @id @default(cuid())
  companyId             String            @map("company_id")
  company               Company           @relation(fields: [companyId], references: [id])
  leadId                String            @unique @map("lead_id")
  lead                  Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// wa_id do contato (telefone E.164 do cliente na Meta)
  waContactId           String            @map("wa_contact_id")
  windowExpiresAt       DateTime?         @map("window_expires_at")
  lastCustomerMessageAt DateTime?         @map("last_customer_message_at")
  /// CRM V2.1 (#568) — último push de "cliente sem resposta" desta conversa.
  /// Anti-spam: 1 push por janela de não-resposta (>= 1ª msg não respondida = já avisado)
  pushNudgedAt          DateTime?         @map("push_nudged_at")
  lastMessageAt         DateTime?         @map("last_message_at")
  unreadCount           Int               @default(0) @map("unread_count")
  messages              WhatsappMessage[]
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  @@unique([companyId, waContactId])
  @@index([companyId, lastMessageAt])
  @@map("gdr_whatsapp_conversations")
}

model WhatsappMessage {
  id             String               @id @default(cuid())
  conversationId String               @map("conversation_id")
  conversation   WhatsappConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      WaMessageDirection
  type           WaMessageType        @default(TEXT)
  text           String?
  mediaUrl       String?              @map("media_url") // storage próprio (mídia da Meta expira)
  mediaMimeType  String?              @map("media_mime_type")
  /// media id da Meta — o proxy GET /crm/whatsapp/media/:id baixa sob demanda
  waMediaId      String?              @map("wa_media_id")
  /// wamid da Cloud API — idempotência do webhook (retry da Meta não duplica)
  waMessageId    String?              @unique @map("wa_message_id")
  status         WaMessageStatus      @default(PENDING)
  statusAt       DateTime?            @map("status_at") // timestamp do último status recebido
  /// User.id do vendedor que enviou (OUT); null = cliente (IN) ou sistema/IA
  sentById       String?              @map("sent_by_id")
  errorDetail    String?              @map("error_detail") // payload de erro da Meta em FAILED
  createdAt      DateTime             @default(now()) @map("created_at")

  /// true = mensagem template paga (fora da janela 24h) — alimenta o custo do F3.1/F4.4
  isTemplate   Boolean @default(false) @map("is_template")
  templateName String? @map("template_name")

  @@index([conversationId, createdAt])
  @@map("gdr_whatsapp_messages")
}

/// F3.2 (#518) — templates aprovados no Meta Business p/ reengajar lead fora
/// da janela de 24h. Sincronizados do painel da Meta (status APPROVED/PENDING/REJECTED).
model WhatsappTemplate {
  id            String   @id @default(cuid())
  companyId     String   @map("company_id")
  company       Company  @relation(fields: [companyId], references: [id])
  /// nome do template no Meta (ex: "reengajamento_reboque")
  name          String
  language      String   @default("pt_BR")
  category      String? // MARKETING / UTILITY / AUTHENTICATION
  status        String   @default("PENDING") // APPROVED / PENDING / REJECTED
  /// corpo com placeholders {{1}} {{2}} — preview p/ o vendedor
  bodyText      String?  @map("body_text")
  /// nº de variáveis do corpo (p/ montar o payload de components)
  variableCount Int      @default(0) @map("variable_count")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([companyId, name, language])
  @@map("gdr_whatsapp_templates")
}

/// F3.5-C3 (#553) — resposta rápida (canned response) do inbox, DENTRO da janela
/// 24h (custo zero — não confundir com WhatsappTemplate, que é pago). ownerId null
/// = compartilhada da loja; preenchido = pessoal do vendedor. Unicidade do atalho
/// por escopo é validada no QuickReplyService (Postgres trata NULLs como distintos).
model QuickReply {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  company   Company  @relation(fields: [companyId], references: [id])
  /// atalho sem a barra, normalizado minúsculo (ex: "pix" → vendedor digita "/pix")
  shortcut  String   @db.VarChar(30)
  /// corpo da resposta; suporta a variável {nome} (primeiro nome do lead, resolvida no inbox)
  text      String
  ownerId   String?  @map("owner_id")
  owner     User?    @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId, shortcut])
  @@map("gdr_quick_replies")
}

/// F3.5-C5 (#555) — lembrete de follow-up do vendedor ("ligar amanhã 14h").
/// Nota manual NÃO tem model próprio: é LeadActivity type NOTE na timeline.
model LeadReminder {
  id         String    @id @default(cuid())
  companyId  String    @map("company_id")
  company    Company   @relation(fields: [companyId], references: [id])
  leadId     String    @map("lead_id")
  lead       Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId     String    @map("user_id") // vendedor dono do lembrete
  user       User      @relation(fields: [userId], references: [id])
  text       String
  dueAt      DateTime  @map("due_at")
  doneAt     DateTime? @map("done_at")
  /// cron já gerou o Alert CRM_REMINDER_DUE deste lembrete — não realertar
  notifiedAt DateTime? @map("notified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([companyId, userId, doneAt, dueAt])
  @@index([doneAt, notifiedAt, dueAt]) // varredura do cron
  @@map("gdr_lead_reminders")
}

/// CRM V2.1 (#568) — assinatura Web Push de um dispositivo do usuário (speed-to-lead
/// no celular do vendedor). Opt-in por dispositivo: sem linhas = sem push; opt-out =
/// deletar a assinatura. endpoint é a URL única do push service do navegador.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("gdr_push_subscriptions")
}

/// F4 SDR IA (#521): estado do atendimento automático do lead.
/// null = nunca atendido pela IA. ACTIVE/QUALIFIED respondem; HANDOFF (humano
/// assumiu ou IA transferiu) e DISCARDED (spam/engano) silenciam a IA.
enum SdrLeadStatus {
  ACTIVE
  QUALIFIED
  HANDOFF
  DISCARDED
}

/// F4 SDR IA (#521/#524) — usage da API Anthropic por turno de conversa.
/// Alimenta a coluna de custo do painel de supervisão.
model SdrUsage {
  id                  String   @id @default(cuid())
  companyId           String   @map("company_id")
  company             Company  @relation(fields: [companyId], references: [id])
  leadId              String   @map("lead_id")
  lead                Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  model               String // model id usado (permite A/B opus/sonnet/haiku)
  inputTokens         Int      @default(0) @map("input_tokens")
  outputTokens        Int      @default(0) @map("output_tokens")
  cacheReadTokens     Int      @default(0) @map("cache_read_tokens")
  cacheCreationTokens Int      @default(0) @map("cache_creation_tokens")
  /// custo estimado do turno em USD (preço de tabela do modelo)
  costUsd             Decimal  @default(0) @map("cost_usd") @db.Decimal(10, 6)
  createdAt           DateTime @default(now()) @map("created_at")

  @@index([companyId, createdAt])
  @@index([leadId])
  @@map("gdr_sdr_usage")
}
