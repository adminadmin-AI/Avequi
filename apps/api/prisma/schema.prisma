generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Empresa / Tenant ─────────────────────────────────────────────────────────

enum TaxRegime {
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL
}

model Company {
  id       String      @id @default(cuid())
  name     String
  cnpj     String      @unique
  type     CompanyType @default(MATRIZ)
  parentId String?
  parent   Company?    @relation("branches", fields: [parentId], references: [id])
  branches Company[]   @relation("branches")

  // ── Dados fiscais ──
  razaoSocial String?
  ie          String? // Inscrição Estadual
  im          String? // Inscrição Municipal
  crt         Int? // Código Regime Tributário: 1=SN, 2=SN-ExSub, 3=Normal
  taxRegime   TaxRegime?
  suframa     String?
  cnae        String? // CNAE principal

  // ── Endereço ──
  street                String?
  number                String?
  complement            String?
  neighborhood          String?
  city                  String?
  state                 String? // UF (2 letras)
  zipCode               String? // CEP
  ibgeCode              String? // Código IBGE do município
  phone                 String?
  email                 String?
  users                 User[]
  auditLogs             AuditLog[]
  products              Product[]
  suppliers             Supplier[]
  customers             Customer[]
  bomVersions           BomVersion[]
  routingSteps          RoutingStep[]
  warehouses            Warehouse[]
  stockBalances         StockBalance[]
  stockMovements        StockMovement[]
  purchaseOrders        PurchaseOrder[]
  goodsReceipts         GoodsReceipt[]
  salesOrders           SalesOrder[]
  fiscalDocuments       FiscalDocument[]
  financialEntries      FinancialEntry[]
  bankAccounts          BankAccount[]
  storeTransfers        StoreTransfer[]
  demandForecasts       DemandForecast[]
  purchaseRequests      PurchaseRequest[]
  supplierPriceHistory  SupplierPriceHistory[]
  systemParameters      SystemParameter[]
  mrpRuns               MrpRun[]
  productionOrders      ProductionOrder[]
  locations             Location[]
  receivingOrders       ReceivingOrder[]
  putawayTasks          PutawayTask[]
  pickingOrders         PickingOrder[]
  pickTasks             PickTask[]
  inventoryCounts       InventoryCount[]
  inventoryItems        InventoryCountItem[]
  alerts                Alert[]
  inspections           Inspection[]
  nonConformances       NonConformance[]
  serialNumbers         SerialNumber[]
  binRegistrations      BinRegistration[]
  atpveRecords          AtpveRecord[]
  renaveOperations      RenaveOperation[]
  equipment             Equipment[]
  maintenanceOrders     MaintenanceOrder[]
  quotations            Quotation[]
  inboundNfes           InboundNfe[]
  workCenters           WorkCenter[]
  batches               Batch[]
  // Finance
  financialCategories   FinancialCategory[]
  costCenters           CostCenter[]
  payables              Payable[]
  receivables           Receivable[]
  // BPM — Approval
  approvalMatrices      ApprovalMatrix[]
  taxRules              TaxRule[]
  fiscalVoidRanges      FiscalVoidRange[]
  threeWayMatches       ThreeWayMatch[]
  // Fase 5
  priceTables           PriceTable[]
  commissionRules       CommissionRule[]
  commissions           Commission[]
  rfqs                  RequestForQuotation[]
  // Fase 6
  nfeManifests          NfeManifest[]
  // Fase 7
  consentRecords        ConsentRecord[]
  anonymizationRequests AnonymizationRequest[]
  budgets               Budget[]
  bankStatements        BankStatement[]
  productionSchedules   ProductionSchedule[]
  scheduledPayments     ScheduledPayment[]
  collectionAttempts    CollectionAttempt[]
  carriers              Carrier[]
  // IAM v2 — F1 (#335/#336/#337)
  roles                 Role[]
  userRoleAssignments   UserRoleAssignment[]
  userPermissions       UserPermission[]
  orgBranches           Branch[]
  departments           Department[]
  userSessions          UserSession[]
  auditLogsV2           AuditLogV2[]
  securityEvents        SecurityEvent[]
  permissionChangeLogs  PermissionChangeLog[]
  // CRM de Lojas — F1.1 (#507) / F1.2 (#508)
  /// phone_number_id do número da loja na WhatsApp Cloud API — mapeia webhook → loja
  waPhoneNumberId       String?                @unique @map("wa_phone_number_id")
  leads                 Lead[]
  pipelineStages        PipelineStage[]
  whatsappConversations WhatsappConversation[]
  whatsappTemplates     WhatsappTemplate[]
  quickReplies          QuickReply[]
  leadReminders         LeadReminder[]
  sdrUsages             SdrUsage[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@map("gdr_companies")
}

enum CompanyType {
  MATRIZ
  FILIAL
}

// ─── Motor Tributário ─────────────────────────────────────────────────────────

enum TaxOperationType {
  VENDA_INTERNA
  VENDA_INTERESTADUAL
  DEVOLUCAO_VENDA
  TRANSFERENCIA_INTERNA
  TRANSFERENCIA_INTERESTADUAL
  COMPRA_INTERNA
  COMPRA_INTERESTADUAL
  DEVOLUCAO_COMPRA
  REMESSA_CONSERTO
  RETORNO_CONSERTO
  AMOSTRA_GRATIS
  BONIFICACAO
  INDUSTRIALIZACAO
}

model TaxRule {
  id                 String           @id @default(cuid())
  companyId          String
  company            Company          @relation(fields: [companyId], references: [id])
  operationType      TaxOperationType
  ncm                String? // Regra por NCM (nullable = regra geral)
  productType        ProductType? // Regra por tipo de produto (nullable = qualquer)
  ufOrigem           String? // UF origem (nullable = qualquer)
  ufDestino          String? // UF destino (nullable = qualquer)
  cfop               String // Ex: 5101, 6101, 5152
  // ICMS
  icmsCst            String // Ex: 00, 10, 20, 40, 41, 60
  icmsAliquota       Decimal          @default(0) @db.Decimal(5, 2)
  icmsBaseReducao    Decimal          @default(100) @db.Decimal(5, 2) // % da base (100 = sem redução)
  // IPI
  ipiCst             String           @default("99") // Ex: 00, 49, 50, 99
  ipiAliquota        Decimal          @default(0) @db.Decimal(5, 2)
  // PIS
  pisCst             String           @default("01") // Ex: 01, 06, 07, 49
  pisAliquota        Decimal          @default(0) @db.Decimal(5, 2)
  // COFINS
  cofinsCst          String           @default("01") // Ex: 01, 06, 07, 49
  cofinsAliquota     Decimal          @default(0) @db.Decimal(5, 2)
  // DIFAL — alíquota interna do UF destino (para cálculo quando consumidor final interestadual)
  icmsInternaDestino Decimal?         @db.Decimal(5, 2) // Alíquota interna do UF destino (ex: 18% SP, 17% SC)
  fcpAliquotaDestino Decimal?         @db.Decimal(5, 2) // % FCP do UF destino no DIFAL (SP 2%, RJ 2% — NF-e real #14236) (#445)
  // IBS/CBS — Reforma Tributária NT 2025.002-RTC (#412)
  cClassTrib         String?          @db.VarChar(6) // código classificação tributária (tabela cClassTrib — #413)
  cbsCst             String?          @db.VarChar(3) // CST CBS (000 = tributação integral)
  cbsAliquota        Decimal?         @db.Decimal(7, 4) // 0.9 em 2026 (fase teste)
  ibsUfCst           String?          @db.VarChar(3)
  ibsUfAliquota      Decimal?         @db.Decimal(7, 4) // 0.1 em 2026 (LC 214/2025 art. 343)
  ibsMunCst          String?          @db.VarChar(3)
  ibsMunAliquota     Decimal?         @db.Decimal(7, 4) // 0 em 2026 — IBS teste é 100% estadual
  // Vigência temporal (#500) — versionamento de NTs e da transição da reforma
  // (2027 CBS definitiva, 2029-32 ICMS→IBS). null = sem limite naquela ponta;
  // o motor resolve pela data de emissão, então NT nova = linha nova com
  // validFrom futuro (carga de dados, não deploy).
  validFrom          DateTime?
  validTo            DateTime?
  // Meta
  description        String?
  priority           Int              @default(0) // Maior = mais específica
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([companyId, operationType, ncm, productType, ufOrigem, ufDestino, validFrom])
  @@index([companyId, operationType])
  @@map("gdr_tax_rules")
}

/// Tabela oficial de Classificação Tributária IBS/CBS (cClassTrib) — IT 2025.002-RTC (#413).
/// Global (sem companyId): tabela de referência nacional, seedada de prisma/data/cclasstrib.ts.
model TributaryClassification {
  id             String    @id @default(cuid())
  code           String    @unique @db.VarChar(6) // cClassTrib, ex: 000001
  description    String
  cst            String    @db.VarChar(3) // CST IBS/CBS (comum aos dois na tabela oficial)
  percRedIbs     Decimal   @default(0) @db.Decimal(7, 4) // % redução alíquota IBS
  percRedCbs     Decimal   @default(0) @db.Decimal(7, 4) // % redução alíquota CBS
  isExempt       Boolean   @default(false) // CST 400 (isenção) / 410 (imunidade)
  isReduced      Boolean   @default(false) // redução de alíquota ou base
  isMonophase    Boolean   @default(false)
  allowsCredPres Boolean   @default(false) // permite crédito presumido
  allowsNfe      Boolean   @default(true) // código aplicável a NF-e/NFC-e
  validFrom      DateTime?
  validTo        DateTime? // null = vigente
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([cst])
  @@map("gdr_tributary_classifications")
}

// ─── Usuário ──────────────────────────────────────────────────────────────────

model User {
  id                        String                 @id @default(cuid())
  name                      String
  email                     String                 @unique
  passwordHash              String
  role                      UserRole               @default(READER)
  isActive                  Boolean                @default(true)
  companyId                 String
  company                   Company                @relation(fields: [companyId], references: [id])
  refreshTokens             RefreshToken[]
  auditLogs                 AuditLog[]
  stockMovements            StockMovement[]
  createdPurchaseOrders     PurchaseOrder[]        @relation("POCreatedBy")
  approvedPurchaseOrders    PurchaseOrder[]        @relation("POApprovedBy")
  goodsReceipts             GoodsReceipt[]         @relation("GRReceivedBy")
  createdSalesOrders        SalesOrder[]           @relation("SOCreatedBy")
  requestedTransfers        StoreTransfer[]        @relation("TransferRequestedBy")
  dispatchedTransfers       StoreTransfer[]        @relation("TransferDispatchedBy")
  receivedTransfers         StoreTransfer[]        @relation("TransferReceivedBy")
  demandForecasts           DemandForecast[]       @relation("DemandCreatedBy")
  purchaseRequests          PurchaseRequest[]      @relation("PRRequestedBy")
  triggeredMrpRuns          MrpRun[]               @relation("MrpTriggeredBy")
  createdProductionOrders   ProductionOrder[]      @relation("POProdCreatedBy")
  productionLogs            ProductionLog[]        @relation("ProductionLogUser")
  putawayConfirmations      PutawayTask[]          @relation("PutawayConfirmedBy")
  pickConfirmations         PickTask[]             @relation("PickConfirmedBy")
  conferredSalesOrders      SalesOrder[]           @relation("SOConferredBy")
  inventoryCountsCreated    InventoryCount[]       @relation("InventoryCreatedBy")
  inventoryCountsReconciled InventoryCount[]       @relation("InventoryReconciledBy")
  inventoryItemsCounted     InventoryCountItem[]   @relation("InventoryItemCountedBy")
  inspectionsLed            Inspection[]           @relation("InspectionInspectedBy")
  ncrResponsibilities       NonConformance[]       @relation("NcrResponsible")
  ncrsClosed                NonConformance[]       @relation("NcrClosedBy")
  ncrsCreated               NonConformance[]       @relation("NcrCreatedBy")
  maintenanceTasks          MaintenanceOrder[]     @relation("MaintenanceTechnician")
  maintenanceOrdersCreated  MaintenanceOrder[]     @relation("MaintenanceCreatedBy")
  quotationsCreated         Quotation[]            @relation("QuotationCreatedBy")
  inboundNfesImported       InboundNfe[]           @relation("InboundNfeImportedBy")
  batchEvents               BatchEvent[]           @relation("BatchEventUser")
  matchResolutions          ThreeWayMatch[]        @relation("MatchResolvedBy")
  commissionRules           CommissionRule[]       @relation("CommissionRuleUser")
  commissions               Commission[]           @relation("CommissionUser")
  rfqsCreated               RequestForQuotation[]  @relation("RfqCreatedBy")
  nfeManifests              NfeManifest[]          @relation("NfeManifestBy")
  anonymizationRequests     AnonymizationRequest[] @relation("AnonymizationRequestedBy")
  // IAM v2 — F1 (#335/#336/#337) — campos e relações aditivas
  lockedUntil               DateTime? // lockout de conta (#336) — null = não bloqueado
  roleAssignments           UserRoleAssignment[]
  permissionExceptions      UserPermission[]
  departmentLinks           UserDepartment[]
  teamLinks                 UserTeam[]
  managedDepartments        Department[]           @relation("DepartmentManager")
  ledTeams                  Team[]                 @relation("TeamLeader")
  sessions                  UserSession[]
  trustedDevices            TrustedDevice[]
  auditLogsV2               AuditLogV2[]
  securityEvents            SecurityEvent[]
  permissionChangesReceived PermissionChangeLog[]  @relation("PermissionChangeTarget")
  permissionChangesMade     PermissionChangeLog[]  @relation("PermissionChangeAuthor")
  // CRM de Lojas — F1.1 (#507)
  assignedLeads             Lead[]                 @relation("LeadAssignee")
  /// Vendedor disponível p/ receber lead no rodízio (#513) — férias/folga = false
  crmAvailable              Boolean                @default(true) @map("crm_available")
  quickReplies              QuickReply[] // F3.5-C3 (#553) — respostas rápidas pessoais
  leadReminders             LeadReminder[] // F3.5-C5 (#555) — lembretes de follow-up
  pushSubscriptions         PushSubscription[] // CRM V2.1 (#568) — web push por dispositivo
  // IAM v2 — F4.1 (#344): MFA/2FA TOTP do usuário (opcional).
  mfa                       UserMFA?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  defaultForCustomersSeller Customer[]             @relation("CustomerDefaultSeller") // padrão comercial do cliente (#475)

  @@map("gdr_users")
}

enum UserRole {
  SUPER_ADMIN
  DIRECTOR
  MANAGER
  COMMERCIAL
  PRODUCTION
  QUALITY
  WAREHOUSE
  FINANCIAL
  STORE
  READER
}

// ─── Auth ─────────────────────────────────────────────────────────────────────

model RefreshToken {
  id        String       @id @default(cuid())
  token     String       @unique
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime     @default(now())
  // IAM v2 (#336): sessão amarrada ao refresh token (Decisão 4 — híbrido)
  session   UserSession?

  @@map("gdr_refresh_tokens")
}

// ─── Auditoria ────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  entity    String
  action    String
  payload   Json?
  createdAt DateTime @default(now())

  @@map("gdr_audit_logs")
}

// ─── Produto ──────────────────────────────────────────────────────────────────

enum ProductType {
  RAW_MATERIAL
  SEMI_FINISHED
  FINISHED_GOOD
  CONSUMABLE
  SERVICE
  COMPONENT
}

enum UnitOfMeasure {
  UN
  KG
  G
  M
  M2
  M3
  L
  PC
  CX
  PR
}

model Product {
  id                        String                 @id @default(cuid())
  companyId                 String
  company                   Company                @relation(fields: [companyId], references: [id])
  sku                       String
  name                      String
  description               String?
  type                      ProductType
  unit                      UnitOfMeasure          @default(UN)
  ncm                       String?
  codigoMarcaModelo         String?                @map("codigo_marca_modelo") @db.VarChar(6) // código RENAVAM marca/modelo, ex: 600657 Carresul (#372)
  cClassTrib                String?                @map("c_class_trib") @db.VarChar(6) // classificação tributária IBS/CBS do produto — ref. TributaryClassification.code (#413)
  origem                    String                 @default("0") @db.VarChar(1) // origem da mercadoria 0-8 (tabela A do ICMS) — orig no XML; 1/2/3/8 = importado → interestadual 4% RSF 13/2012 (#480)
  ean                       String?                @db.VarChar(14) // GTIN (cEAN) — SEFAZ valida no Cadastro Centralizado; vazio = Focus emite SEM GTIN (#484)
  cest                      String?                @db.VarChar(7) // código CEST quando sujeito a ST (#484)
  pesoLiquido               Decimal?               @map("peso_liquido") @db.Decimal(12, 3) // kg — alimenta volumes da NF-e (#484)
  pesoBruto                 Decimal?               @map("peso_bruto") @db.Decimal(12, 3) // kg (#484)
  unidadeTributavel         String?                @map("unidade_tributavel") @db.VarChar(6) // uTrib quando ≠ unidade comercial (#484)
  fatorConversaoTributavel  Decimal?               @map("fator_conversao_tributavel") @db.Decimal(12, 6) // qTrib = qCom × fator (#484)
  costPrice                 Decimal?               @db.Decimal(14, 4)
  salePrice                 Decimal?               @db.Decimal(14, 4)
  avgCost                   Decimal?               @db.Decimal(14, 4)
  minStock                  Decimal                @default(0) @db.Decimal(14, 4)
  minOrderQty               Decimal?               @db.Decimal(14, 4)
  orderMultiple             Decimal?               @db.Decimal(14, 4)
  minProductionQty          Decimal?               @db.Decimal(14, 4)
  productionMultiple        Decimal?               @db.Decimal(14, 4)
  leadTimeDays              Int?                   @default(0)
  requiresFinalInspection   Boolean                @default(false)
  tracksSerial              Boolean                @default(false)
  isActive                  Boolean                @default(true)
  batches                   Batch[]                @relation("BatchProduct")
  boms                      BomVersion[]           @relation("ProductBoms")
  usedInBoms                BomItem[]              @relation("ComponentOf")
  routingSteps              RoutingStep[]          @relation("ProductRouting")
  stockBalances             StockBalance[]
  stockMovements            StockMovement[]
  poItems                   POItem[]
  grItems                   GRItem[]
  saleItems                 SaleItem[]
  transferItems             StoreTransferItem[]
  demandForecasts           DemandForecast[]
  purchaseRequests          PurchaseRequest[]
  supplierPriceHistory      SupplierPriceHistory[]
  mrpSuggestions            MrpSuggestion[]
  productionOrdersAsProduct ProductionOrder[]      @relation("ProductionOrderProduct")
  productionOrderItems      ProductionOrderItem[]  @relation("ProductionOrderComponent")
  putawayTasks              PutawayTask[]          @relation("PutawayProduct")
  pickTasks                 PickTask[]             @relation("PickTaskProduct")
  inventoryItems            InventoryCountItem[]   @relation("InventoryItemProduct")
  nonConformances           NonConformance[]       @relation("NcrProduct")
  serialNumbers             SerialNumber[]         @relation("SerialProduct")
  serialComponents          SerialComponent[]      @relation("SerialComponentProduct")
  quotationItems            QuotationItem[]        @relation("QuotationItemProduct")
  priceTableItems           PriceTableItem[]
  rfqItems                  RfqItem[]
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  @@unique([companyId, sku])
  @@map("gdr_products")
}

// ─── Fornecedor ───────────────────────────────────────────────────────────────

model Supplier {
  id                   String                 @id @default(cuid())
  companyId            String
  company              Company                @relation(fields: [companyId], references: [id])
  name                 String // nome fantasia / apelido comercial (#478)
  razaoSocial          String?                @map("razao_social") // razão social (#478)
  cnpj                 String?
  ie                   String?                @db.VarChar(14) // inscrição estadual (#478)
  taxRegime            TaxRegime?             @map("tax_regime") // regime tributário — crédito IBS/CBS nas compras a partir de 2027 (#478)
  email                String?
  fiscalEmail          String?                @map("fiscal_email") // e-mail p/ NF-e/boleto (#478)
  phone                String?
  phone2               String?
  contactName          String?                @map("contact_name")
  address              String? // logradouro (#478)
  number               String?                @db.VarChar(10)
  complement           String?                @db.VarChar(60)
  neighborhood         String?                @db.VarChar(60)
  city                 String?
  state                String?                @db.VarChar(2)
  zipCode              String?                @map("zip_code") @db.VarChar(8)
  ibgeCode             String?                @map("ibge_code") @db.VarChar(7)
  defaultPaymentTerms  String?                @map("default_payment_terms") // condição de pagamento padrão — pré-preenche PO (#478)
  bankName             String?                @map("bank_name")
  bankAgency           String?                @map("bank_agency")
  bankAccount          String?                @map("bank_account")
  pixKey               String?                @map("pix_key")
  leadTimeDays         Int                    @default(0)
  isActive             Boolean                @default(true)
  purchaseOrders       PurchaseOrder[]
  supplierPriceHistory SupplierPriceHistory[]
  nonConformances      NonConformance[]
  portalTokens         SupplierToken[]
  batches              Batch[]                @relation("BatchSupplier")
  payables             Payable[]
  rfqQuotes            RfqQuote[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@unique([companyId, cnpj])
  @@map("gdr_suppliers")
}

// ─── Cliente ──────────────────────────────────────────────────────────────────

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

/// Indicador de IE do destinatário (indIEDest da NF-e) — explícito no cadastro (#474)
enum IcmsIndicator {
  CONTRIBUINTE // 1 — exige IE válida
  ISENTO // 2 — contribuinte isento de IE
  NAO_CONTRIBUINTE // 9 — consumidor final PF/PJ não contribuinte
}

model Customer {
  id                  String            @id @default(cuid())
  companyId           String
  company             Company           @relation(fields: [companyId], references: [id])
  type                CustomerType      @default(COMPANY)
  name                String // nome fantasia / apelido comercial
  razaoSocial         String?           @map("razao_social") // razão social (PJ) — DANFE usa quando presente (#474)
  document            String?
  email               String?
  fiscalEmail         String?           @map("fiscal_email") // e-mail p/ NF-e/boleto (fallback: email) (#474)
  phone               String?
  phone2              String?
  contactName         String?           @map("contact_name")
  address             String? // logradouro (rua, av, etc.)
  number              String?           @db.VarChar(10)
  complement          String?           @db.VarChar(60)
  neighborhood        String?           @db.VarChar(60) // bairro
  city                String?
  state               String?           @db.VarChar(2)
  zipCode             String?           @map("zip_code") @db.VarChar(8) // CEP sem máscara
  ibgeCode            String?           @map("ibge_code") @db.VarChar(7) // código município IBGE
  ie                  String?           @db.VarChar(14) // inscrição estadual
  // Fiscal (#474) — indIeDest null = inferir por IE/CPF (cadastros antigos)
  indIeDest           IcmsIndicator?    @map("ind_ie_dest")
  isRuralProducer     Boolean           @default(false) @map("is_rural_producer") // IE de produtor no campo ie
  isSimplesNacional   Boolean           @default(false) @map("is_simples_nacional")
  // Crédito e cobrança (#475) — casa com Receivable (em aberto é query, não campo)
  creditLimit         Decimal?          @map("credit_limit") @db.Decimal(14, 2)
  billingBlocked      Boolean           @default(false) @map("billing_blocked")
  billingBlockReason  String?           @map("billing_block_reason")
  // Padrões comerciais (#475) — pré-preenchem a OV
  defaultSellerId     String?           @map("default_seller_id")
  defaultSeller       User?             @relation("CustomerDefaultSeller", fields: [defaultSellerId], references: [id])
  defaultPaymentTerms String?           @map("default_payment_terms") // ex: "30/60/90" ou "à vista"
  defaultCarrierId    String?           @map("default_carrier_id")
  defaultCarrier      Carrier?          @relation("CustomerDefaultCarrier", fields: [defaultCarrierId], references: [id])
  internalNotes       String?           @map("internal_notes") // nunca vai para documentos fiscais
  isActive            Boolean           @default(true)
  leads               Lead[] // CRM F1.1 (#507) — preenchido na conversão lead→cliente (F2.2)
  addresses           CustomerAddress[]
  salesOrders         SalesOrder[]
  quotations          Quotation[]
  receivables         Receivable[]
  priceTables         PriceTable[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([companyId, document])
  @@map("gdr_customers")
}

/// Endereços de entrega do cliente (1:N) — grupo <entrega> da NF-e (#474)
model CustomerAddress {
  id           String       @id @default(cuid())
  customerId   String       @map("customer_id")
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label        String // ex: "Obra Fazenda Santa Fé", "Depósito Matriz"
  address      String
  number       String?      @db.VarChar(10)
  complement   String?      @db.VarChar(60)
  neighborhood String?      @db.VarChar(60)
  city         String
  state        String       @db.VarChar(2)
  zipCode      String?      @map("zip_code") @db.VarChar(8)
  ibgeCode     String?      @map("ibge_code") @db.VarChar(7)
  isDefault    Boolean      @default(false) @map("is_default")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  salesOrders  SalesOrder[]

  @@index([customerId])
  @@map("gdr_customer_addresses")
}

/// Transportadora — grupo transp da NF-e (#481). Entidade fiscal própria (≠ Supplier).
model Carrier {
  id                         String       @id @default(cuid())
  companyId                  String
  company                    Company      @relation(fields: [companyId], references: [id])
  name                       String // nome fantasia
  razaoSocial                String?      @map("razao_social") // xNome do transportador
  document                   String? // CNPJ (14) ou CPF (11), sem máscara
  ie                         String?      @db.VarChar(14)
  address                    String? // xEnder (logradouro + número, campo único na NF-e)
  city                       String?
  state                      String?      @db.VarChar(2)
  vehiclePlate               String?      @map("vehicle_plate") @db.VarChar(8)
  vehiclePlateState          String?      @map("vehicle_plate_state") @db.VarChar(2)
  rntc                       String?      @db.VarChar(20) // registro nacional de transportador de carga (ANTT)
  isActive                   Boolean      @default(true)
  salesOrders                SalesOrder[]
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt
  defaultForCustomersCarrier Customer[]   @relation("CustomerDefaultCarrier") // padrão comercial do cliente (#475)

  @@unique([companyId, document])
  @@map("gdr_carriers")
}

// ─── BOM — Bill of Materials ──────────────────────────────────────────────────

model BomVersion {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  productId String
  product   Product   @relation("ProductBoms", fields: [productId], references: [id])
  version   Int
  isActive  Boolean   @default(false)
  notes     String?
  items     BomItem[]
  createdAt DateTime  @default(now())

  @@unique([productId, version])
  @@map("gdr_bom_versions")
}

model BomItem {
  id           String        @id @default(cuid())
  bomVersionId String
  bomVersion   BomVersion    @relation(fields: [bomVersionId], references: [id], onDelete: Cascade)
  componentId  String
  component    Product       @relation("ComponentOf", fields: [componentId], references: [id])
  quantity     Decimal       @db.Decimal(14, 4)
  scrapPct     Decimal       @default(0) @db.Decimal(5, 2)
  unit         UnitOfMeasure @default(UN)

  @@map("gdr_bom_items")
}

// ─── Roteiro de Produção ─────────────────────────────────────────────────────

model RoutingStep {
  id             String          @id @default(cuid())
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id])
  productId      String
  product        Product         @relation("ProductRouting", fields: [productId], references: [id])
  stepOrder      Int
  name           String
  workCenter     String?
  setupTimeMin   Int             @default(0)
  runTimeMin     Int             @default(0)
  notes          String?
  productionLogs ProductionLog[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([productId, stepOrder])
  @@map("gdr_routing_steps")
}

// ─── Estoque ──────────────────────────────────────────────────────────────────

enum MovementType {
  ENTRY
  EXIT
  ADJUSTMENT
  REVERSAL
  TRANSFER_OUT
  TRANSFER_IN
}

model Warehouse {
  id               String            @id @default(cuid())
  companyId        String
  company          Company           @relation(fields: [companyId], references: [id])
  name             String
  code             String
  description      String?
  isActive         Boolean           @default(true)
  wmsEnabled       Boolean           @default(false)
  batches          Batch[]
  balances         StockBalance[]
  movements        StockMovement[]
  goodsReceipts    GoodsReceipt[]
  salesOrders      SalesOrder[]
  transfersFrom    StoreTransfer[]   @relation("TransferFrom")
  transfersTo      StoreTransfer[]   @relation("TransferTo")
  productionOrders ProductionOrder[]
  locations        Location[]
  receivingOrders  ReceivingOrder[]
  pickingOrders    PickingOrder[]
  inventoryCounts  InventoryCount[]
  serialNumbers    SerialNumber[]
  quotations       Quotation[]
  priceTables      PriceTable[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([companyId, code])
  @@map("gdr_warehouses")
}

model StockBalance {
  id             String    @id @default(cuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id])
  warehouseId    String
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id])
  productId      String
  product        Product   @relation(fields: [productId], references: [id])
  available      Decimal   @default(0) @db.Decimal(14, 4)
  reserved       Decimal   @default(0) @db.Decimal(14, 4)
  inTransit      Decimal   @default(0) @db.Decimal(14, 4)
  pendingPutaway Decimal   @default(0) @db.Decimal(14, 4)
  updatedAt      DateTime  @updatedAt

  @@unique([warehouseId, productId])
  @@map("gdr_stock_balances")
}

model StockMovement {
  id           String       @id @default(cuid())
  companyId    String
  company      Company      @relation(fields: [companyId], references: [id])
  warehouseId  String
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id])
  productId    String
  product      Product      @relation(fields: [productId], references: [id])
  type         MovementType
  quantity     Decimal      @db.Decimal(14, 4)
  reason       String
  reference    String?
  reversedById String?
  userId       String?
  user         User?        @relation(fields: [userId], references: [id])
  createdAt    DateTime     @default(now())

  @@map("gdr_stock_movements")
}

// ─── Compras ──────────────────────────────────────────────────────────────────

enum PurchaseRequestStatus {
  OPEN
  APPROVED
  CONVERTED
  CANCELLED
}

model PurchaseRequest {
  id            String                @id @default(cuid())
  companyId     String
  company       Company               @relation(fields: [companyId], references: [id])
  productId     String
  product       Product               @relation(fields: [productId], references: [id])
  quantity      Decimal               @db.Decimal(14, 4)
  unit          UnitOfMeasure         @default(UN)
  neededBy      DateTime?
  justification String?
  status        PurchaseRequestStatus @default(OPEN)
  requestedById String?
  requestedBy   User?                 @relation("PRRequestedBy", fields: [requestedById], references: [id])
  convertedToId String?
  convertedTo   PurchaseOrder?        @relation("PRConvertedTo", fields: [convertedToId], references: [id])
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([companyId, status])
  @@map("gdr_purchase_requests")
}

model SupplierPriceHistory {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  supplierId     String
  supplier       Supplier @relation(fields: [supplierId], references: [id])
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  unitCost       Decimal  @db.Decimal(14, 4)
  goodsReceiptId String?
  recordedAt     DateTime @default(now())

  @@index([supplierId, productId])
  @@index([companyId])
  @@map("gdr_supplier_price_history")
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id                    String              @id @default(cuid())
  companyId             String
  company               Company             @relation(fields: [companyId], references: [id])
  supplierId            String
  supplier              Supplier            @relation(fields: [supplierId], references: [id])
  status                PurchaseOrderStatus @default(DRAFT)
  expectedAt            DateTime?
  notes                 String?
  createdById           String?
  createdBy             User?               @relation("POCreatedBy", fields: [createdById], references: [id])
  approvedById          String?
  approvedBy            User?               @relation("POApprovedBy", fields: [approvedById], references: [id])
  approvedAt            DateTime?
  items                 POItem[]
  receipts              GoodsReceipt[]
  financialEntries      FinancialEntry[]
  payables              Payable[]
  convertedFromRequests PurchaseRequest[]   @relation("PRConvertedTo")
  inboundNfes           InboundNfe[]
  threeWayMatches       ThreeWayMatch[]
  mrpSuggestions        MrpSuggestion[]     @relation("MrpConvertedPO")
  rfqQuotes             RfqQuote[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@map("gdr_purchase_orders")
}

model POItem {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product       @relation(fields: [productId], references: [id])
  quantity         Decimal       @db.Decimal(14, 4)
  unitCost         Decimal       @db.Decimal(14, 4)
  unit             UnitOfMeasure @default(UN)
  receivedQuantity Decimal       @default(0) @db.Decimal(14, 4)
  grItems          GRItem[]

  @@map("gdr_po_items")
}

model GoodsReceipt {
  id              String          @id @default(cuid())
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id])
  purchaseOrderId String
  purchaseOrder   PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id])
  warehouseId     String
  warehouse       Warehouse       @relation(fields: [warehouseId], references: [id])
  receivedById    String?
  receivedBy      User?           @relation("GRReceivedBy", fields: [receivedById], references: [id])
  notes           String?
  items           GRItem[]
  batches         Batch[]
  financialEntry  FinancialEntry?
  receivingOrder  ReceivingOrder?
  inspections     Inspection[]
  inboundNfe      InboundNfe?
  threeWayMatches ThreeWayMatch[]
  createdAt       DateTime        @default(now())

  @@map("gdr_goods_receipts")
}

model GRItem {
  id               String       @id @default(cuid())
  goodsReceiptId   String
  goodsReceipt     GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  poItemId         String
  poItem           POItem       @relation(fields: [poItemId], references: [id])
  productId        String
  product          Product      @relation(fields: [productId], references: [id])
  qtyOrdered       Decimal      @db.Decimal(14, 4)
  qtyReceived      Decimal      @db.Decimal(14, 4)
  divergenceReason String?

  @@map("gdr_gr_items")
}

// ─── 3-Way Match ──────────────────────────────────────────────────────────────

enum ThreeWayMatchResult {
  FULL_MATCH
  PARTIAL_MATCH
  MISMATCH
}

model ThreeWayMatch {
  id              String              @id @default(cuid())
  companyId       String
  company         Company             @relation(fields: [companyId], references: [id])
  purchaseOrderId String
  purchaseOrder   PurchaseOrder       @relation(fields: [purchaseOrderId], references: [id])
  goodsReceiptId  String
  goodsReceipt    GoodsReceipt        @relation(fields: [goodsReceiptId], references: [id])
  inboundNfeId    String?
  inboundNfe      InboundNfe?         @relation(fields: [inboundNfeId], references: [id])
  result          ThreeWayMatchResult
  qtyTolerance    Decimal             @default(0) @db.Decimal(5, 2)
  priceTolerance  Decimal             @default(2) @db.Decimal(5, 2)
  details         Json // Array of per-item match details
  resolvedById    String?
  resolvedBy      User?               @relation("MatchResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([companyId, result])
  @@index([purchaseOrderId])
  @@map("gdr_three_way_matches")
}

// ─── Vendas ───────────────────────────────────────────────────────────────────

enum SalesOrderStatus {
  DRAFT
  RESERVED
  CONFIRMED
  AWAITING_PICKING
  AWAITING_CONFERENCE // separado, aguardando conferência da carga (#491)
  READY_TO_INVOICE
  INVOICED
  RETURNED
  CANCELLED
}

model SalesOrder {
  id                String            @id @default(cuid())
  companyId         String
  company           Company           @relation(fields: [companyId], references: [id])
  customerId        String?
  customer          Customer?         @relation(fields: [customerId], references: [id])
  lead              Lead? // CRM F2.2 (#515) — lead que originou esta OV (back-relation)
  warehouseId       String
  warehouse         Warehouse         @relation(fields: [warehouseId], references: [id])
  status            SalesOrderStatus  @default(DRAFT)
  paymentMethod     PaymentMethod?    @map("payment_method") // forma de pagamento da venda → detPag da NF-e (#479)
  deliveryAddressId String?           @map("delivery_address_id") // endereço de entrega ≠ fiscal → grupo <entrega> (#474)
  deliveryAddress   CustomerAddress?  @relation(fields: [deliveryAddressId], references: [id])
  // Frete e transporte → grupo transp da NF-e (#481)
  freightModality   String?           @map("freight_modality") @db.VarChar(1) // modFrete: 0-CIF 1-FOB 2-terceiros 3-próprio remetente 4-próprio destinatário 9-sem frete (null = 9)
  freightValue      Decimal?          @map("freight_value") @db.Decimal(14, 2) // vFrete
  carrierId         String?           @map("carrier_id")
  carrier           Carrier?          @relation(fields: [carrierId], references: [id])
  volumesQuantity   Int?              @map("volumes_quantity") // qVol; null = calcular da quantidade de itens
  volumesSpecies    String?           @map("volumes_species") @db.VarChar(60) // esp, ex: "REBOQUE"
  notes             String?
  createdById       String?
  createdBy         User?             @relation("SOCreatedBy", fields: [createdById], references: [id])
  confirmedAt       DateTime?
  pickedAt          DateTime?
  conferredAt       DateTime?         @map("conferred_at") // conferência da carga (#491)
  conferredById     String?           @map("conferred_by_id")
  conferredBy       User?             @relation("SOConferredBy", fields: [conferredById], references: [id])
  invoicedAt        DateTime?
  returnedAt        DateTime?
  cancelledAt       DateTime?
  items             SaleItem[]
  fiscalDocument    FiscalDocument?
  financialEntry    FinancialEntry?
  pickingOrder      PickingOrder?
  serialNumbers     SerialNumber[]
  quotation         Quotation?
  receivable        Receivable?
  commissions       Commission[]
  atpveRecords      AtpveRecord[]
  renaveOperations  RenaveOperation[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@map("gdr_sales_orders")
}

model SaleItem {
  id             String        @id @default(cuid())
  salesOrderId   String
  salesOrder     SalesOrder    @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product       @relation(fields: [productId], references: [id])
  quantity       Decimal       @db.Decimal(14, 4)
  unitPrice      Decimal       @db.Decimal(14, 4)
  unit           UnitOfMeasure @default(UN)
  serialNumberId String?
  serialNumber   SerialNumber? @relation("SaleItemSerial", fields: [serialNumberId], references: [id])

  @@map("gdr_sale_items")
}

// ─── Fiscal ───────────────────────────────────────────────────────────────────

enum FiscalDocumentType {
  NFE
  NFCE
}

enum FiscalStatus {
  PENDING
  PROCESSING
  AUTHORIZED
  REJECTED
  CANCELLED
  ERROR
}

model FiscalDocument {
  id                        String               @id @default(cuid())
  companyId                 String
  company                   Company              @relation(fields: [companyId], references: [id])
  salesOrderId              String?              @unique
  salesOrder                SalesOrder?          @relation(fields: [salesOrderId], references: [id])
  storeTransferId           String?              @unique
  storeTransfer             StoreTransfer?       @relation(fields: [storeTransferId], references: [id])
  type                      FiscalDocumentType   @default(NFCE)
  status                    FiscalStatus         @default(PENDING)
  focusRef                  String?
  chave                     String?
  number                    Int? // número da NF-e retornado pelo Focus (#361)
  series                    Int?                 @default(1)
  protocolNumber            String? // nProt da SEFAZ (#361)
  authorizedAt              DateTime? // data/hora de autorização (#361)
  // Totais IBS/CBS — grupo W03 NT 2025.002-RTC (#412)
  vIBS                      Decimal?             @db.Decimal(14, 2) // Σ (vIBSUF + vIBSMun) dos itens
  vCBS                      Decimal?             @db.Decimal(14, 2) // Σ vCBS dos itens
  vCredPres                 Decimal?             @db.Decimal(14, 2)
  vCredPresCondSus          Decimal?             @db.Decimal(14, 2)
  vIBSMono                  Decimal?             @db.Decimal(14, 2)
  vCBSMono                  Decimal?             @db.Decimal(14, 2)
  xml                       String?
  danfeUrl                  String?              @map("danfe_url") // caminho_danfe do webhook Focus — reimpressão do DANFE (#482)
  xmlUrl                    String?              @map("xml_url") // caminho_xml_nota_fiscal do webhook Focus (#482)
  rejectionCode             String?
  rejectionReason           String?
  retryCount                Int                  @default(0)
  lastError                 String?
  infCpl                    String? // Informações complementares da NF-e (#370)
  cancelledAt               DateTime?
  cancellationJustification String?
  financialEntry            FinancialEntry?
  items                     FiscalDocumentItem[]
  corrections               FiscalCorrection[]
  renaveOperations          RenaveOperation[]
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  @@unique([companyId, series, number, type]) // controle de numeração fiscal (#361)
  @@map("gdr_fiscal_documents")
}

model FiscalCorrection {
  id               String         @id @default(cuid())
  fiscalDocumentId String
  fiscalDocument   FiscalDocument @relation(fields: [fiscalDocumentId], references: [id])
  sequenceNumber   Int // 1 a 20 (máximo SEFAZ)
  correctionText   String
  protocol         String? // protocolo retornado pela SEFAZ
  createdAt        DateTime       @default(now())

  @@unique([fiscalDocumentId, sequenceNumber])
  @@index([fiscalDocumentId])
  @@map("gdr_fiscal_corrections")
}

model FiscalVoidRange {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  serie         String // série da NF-e (ex: "1")
  numberStart   Int // número inicial
  numberEnd     Int // número final
  justification String
  protocol      String? // protocolo retornado pela SEFAZ
  year          Int // ano fiscal
  createdAt     DateTime @default(now())

  @@index([companyId])
  @@map("gdr_fiscal_void_ranges")
}

model FiscalDocumentItem {
  id               String                  @id @default(cuid())
  fiscalDocumentId String
  fiscalDocument   FiscalDocument          @relation(fields: [fiscalDocumentId], references: [id], onDelete: Cascade)
  productId        String?
  productCode      String?
  productName      String
  ncm              String?
  cest             String? // Código Especificador de Substituição Tributária
  cfop             String?
  unit             String?
  quantity         Decimal                 @db.Decimal(14, 4)
  unitPrice        Decimal                 @db.Decimal(14, 4)
  totalPrice       Decimal                 @db.Decimal(14, 4)
  legacyId         String?
  taxes            FiscalDocumentItemTax[]

  @@index([fiscalDocumentId])
  @@map("gdr_fiscal_document_items")
}

model FiscalDocumentItemTax {
  id                   String             @id @default(cuid())
  fiscalDocumentItemId String
  fiscalDocumentItem   FiscalDocumentItem @relation(fields: [fiscalDocumentItemId], references: [id], onDelete: Cascade)
  cstIcms              String?
  baseIcms             Decimal?           @db.Decimal(14, 4)
  aliquotaIcms         Decimal?           @db.Decimal(14, 4)
  valorIcms            Decimal?           @db.Decimal(14, 4)
  cstIpi               String?
  baseIpi              Decimal?           @db.Decimal(14, 4)
  aliquotaIpi          Decimal?           @db.Decimal(14, 4)
  valorIpi             Decimal?           @db.Decimal(14, 4)
  cstPis               String?
  basePis              Decimal?           @db.Decimal(14, 4)
  aliquotaPis          Decimal?           @db.Decimal(14, 4)
  valorPis             Decimal?           @db.Decimal(14, 4)
  cstCofins            String?
  baseCofins           Decimal?           @db.Decimal(14, 4)
  aliquotaCofins       Decimal?           @db.Decimal(14, 4)
  valorCofins          Decimal?           @db.Decimal(14, 4)
  // DIFAL (#369)
  difalBase            Decimal?           @db.Decimal(14, 4)
  difalAliqInterna     Decimal?           @db.Decimal(5, 2)
  difalAliqInterest    Decimal?           @db.Decimal(5, 2)
  difalValor           Decimal?           @db.Decimal(14, 4)
  // FCP do UF destino no DIFAL (#445)
  difalFcpAliquota     Decimal?           @db.Decimal(5, 2)
  difalFcpValor        Decimal?           @db.Decimal(14, 4)
  // IBS/CBS — NT 2025.002-RTC (#412)
  cClassTrib           String?            @db.VarChar(6)
  cIndOp               String?            @db.VarChar(1) // indicador de operação (B25d)
  cstCbs               String?            @db.VarChar(3)
  baseCbs              Decimal?           @db.Decimal(14, 4)
  aliquotaCbs          Decimal?           @db.Decimal(7, 4)
  valorCbs             Decimal?           @db.Decimal(14, 4)
  cstIbsUf             String?            @db.VarChar(3)
  baseIbsUf            Decimal?           @db.Decimal(14, 4)
  aliquotaIbsUf        Decimal?           @db.Decimal(7, 4)
  valorIbsUf           Decimal?           @db.Decimal(14, 4)
  cstIbsMun            String?            @db.VarChar(3)
  baseIbsMun           Decimal?           @db.Decimal(14, 4)
  aliquotaIbsMun       Decimal?           @db.Decimal(7, 4)
  valorIbsMun          Decimal?           @db.Decimal(14, 4)

  @@map("gdr_fiscal_document_item_taxes")
}

// ─── Financeiro ───────────────────────────────────────────────────────────────

enum FinancialEntryType {
  RECEIVABLE
  PAYABLE
}

enum FinancialEntryStatus {
  OPEN
  OVERDUE
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  BOLETO
  PIX
  TED
  DINHEIRO
  CARTAO
  CHEQUE
}

enum EntrySource {
  AUTO_SALES
  AUTO_PURCHASE
  MANUAL
}

model FinancialEntry {
  id                 String                 @id @default(cuid())
  companyId          String
  company            Company                @relation(fields: [companyId], references: [id])
  type               FinancialEntryType
  status             FinancialEntryStatus   @default(OPEN)
  amount             Decimal                @db.Decimal(14, 4)
  dueDate            DateTime
  description        String?
  source             EntrySource            @default(AUTO_SALES)
  attachmentUrl      String?
  salesOrderId       String?                @unique
  salesOrder         SalesOrder?            @relation(fields: [salesOrderId], references: [id])
  purchaseOrderId    String?
  purchaseOrder      PurchaseOrder?         @relation(fields: [purchaseOrderId], references: [id])
  goodsReceiptId     String?                @unique
  goodsReceipt       GoodsReceipt?          @relation(fields: [goodsReceiptId], references: [id])
  fiscalDocumentId   String?                @unique
  fiscalDocument     FiscalDocument?        @relation(fields: [fiscalDocumentId], references: [id])
  categoryId         String?
  category           FinancialCategory?     @relation(fields: [categoryId], references: [id])
  paidAt             DateTime?
  paidAmount         Decimal?               @db.Decimal(14, 4)
  paymentNote        String?
  parentEntryId      String?
  parentEntry        FinancialEntry?        @relation("Installments", fields: [parentEntryId], references: [id])
  installments       FinancialEntry[]       @relation("Installments")
  payments           Payment[]
  costCenterSplits   EntryCostCenterSplit[]
  scheduledPayments  ScheduledPayment[]
  collectionAttempts CollectionAttempt[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([companyId])
  @@index([type, status])
  @@index([dueDate])
  @@index([parentEntryId])
  @@map("gdr_financial_entries")
}

model Payment {
  id               String         @id @default(cuid())
  financialEntryId String
  financialEntry   FinancialEntry @relation(fields: [financialEntryId], references: [id])
  amount           Decimal        @db.Decimal(14, 4)
  paidAt           DateTime
  method           PaymentMethod
  bankAccountId    String?
  bankAccount      BankAccount?   @relation(fields: [bankAccountId], references: [id])
  reference        String?
  createdAt        DateTime       @default(now())

  @@index([financialEntryId])
  @@index([bankAccountId])
  @@map("gdr_payments")
}

model EntryCostCenterSplit {
  id           String         @id @default(cuid())
  entryId      String
  entry        FinancialEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  costCenterId String
  costCenter   CostCenter     @relation(fields: [costCenterId], references: [id])
  percentage   Decimal        @db.Decimal(5, 2)
